# MongoDB Atlas - Get from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-study-assistant?retryWrites=true&w=majority

# JWT - Any long random string (min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars
JWT_EXPIRES_IN=7d

# Groq API (FREE - no credit card needed)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE_MB=10
